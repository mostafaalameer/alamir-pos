{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlamirMarketPOS",
  "version": "1.0.0",
  "identifier": "eg.alamirmarket.pos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ماركت الأمير - نقطة البيع (Alamir Market POS)",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["resources/backend"]
  }
}
