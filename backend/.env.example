# ============================================================================
# Alamir Market POS - Backend Environment Configuration Template
# Copy this file to `backend/.env` and replace with your rotated credentials.
# SECURITY WARNING: Never commit `backend/.env` to version control.
# ============================================================================

PORT=4000
NODE_ENV=development

# Rotate your Supabase database password in:
# Supabase Dashboard -> Project Settings -> Database -> Database Password
DATABASE_URL="postgresql://postgres:YOUR_ROTATED_SUPABASE_PASSWORD@db.yjvzoecpwhzxnmphovdf.supabase.co:5432/postgres"

# Use a strong 256-bit random secret in production
JWT_SECRET="replace-with-strong-random-jwt-secret-key"

# Store Localization
STORE_NAME="ماركت الأمير (Alamir Market)"
COUNTRY="EG"
LOCALE="ar-EG"
CURRENCY="ج.م"

# Optional Error Monitoring (Sentry DSN or Webhook URL)
SENTRY_DSN=""
